# Repo de deploy (contenido de `next build` / `out/` en la raíz).
# NO ignores _next/, __next*.txt ni index.txt: son parte del sitio en producción.

# --- Si compilas Next.js en esta carpeta (o copias desde otro proyecto) ---
node_modules/
.next/
.turbo/
.vercel/
dist/
# Carpeta de salida antes de copiar a la raíz (workflow manual)
out/

# --- Secretos y entorno ---
.env
.env.*
!.env.example

# --- Logs y cachés ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editores / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# --- Temporales / backups ---
*.tmp
*.temp
*.bak
*.orig
~$*

# --- Archivos sueltos de deploy / pruebas locales ---
*.zip
*.7z
